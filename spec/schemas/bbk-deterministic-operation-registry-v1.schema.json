{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-deterministic-operation-registry-v1.schema.json",
  "title": "BBK Deterministic Operation Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "revision", "operations"],
  "properties": {
    "schema": {"const": "bbk.deterministic-operation-registry.v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "version", "implementation_sha256", "entrypoint", "subject_kind", "argv", "environment_policy", "allowed_effects", "output_schema", "invalidation_keys", "qualification"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "entrypoint": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"},
        "subject_kind": {"enum": ["repository", "path", "schema", "json", "work_unit"]},
        "argv": {"type": "array", "items": {"type": "string"}},
        "environment_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowed_variables"],
          "properties": {
            "mode": {"enum": ["NONE", "ALLOWLIST"]},
            "allowed_variables": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "allowed_effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["READ_ONLY", "IDEMPOTENT_DISPOSABLE"]}},
        "output_schema": {"type": "string", "minLength": 1},
        "invalidation_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "qualified_by", "qualification_revision"],
          "properties": {
            "status": {"const": "QUALIFIED"},
            "qualified_by": {"type": "string", "minLength": 1},
            "qualification_revision": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
