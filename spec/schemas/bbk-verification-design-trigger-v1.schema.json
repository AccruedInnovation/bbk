{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-verification-design-trigger-v1.schema.json",
  "title": "BBK Verification Design Trigger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject_ref", "trigger", "material_ambiguity", "why_template_is_insufficient", "required_designer_output", "unaffected_work_may_continue"],
  "properties": {
    "schema": {"const": "bbk.verification-design-trigger.v1"},
    "subject_ref": {"type": "string", "minLength": 1},
    "trigger": {"enum": ["METHOD_AMBIGUITY", "ENVIRONMENT_UNAVAILABLE_OR_DISPUTED", "NONTRIVIAL_INDEPENDENCE", "NOVEL_PROTECTED_FLOOR_OR_QUALITY_ATTRIBUTE", "CROSS_CUTTING_AGGREGATE"]},
    "material_ambiguity": {"type": "string", "minLength": 1},
    "why_template_is_insufficient": {"type": "string", "minLength": 1},
    "required_designer_output": {"type": "string", "minLength": 1},
    "unaffected_work_may_continue": {"type": "boolean"}
  }
}
