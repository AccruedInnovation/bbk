{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-compiled-procedure-manifest-v1.schema.json",
  "title": "BBK Compiled Procedure Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role",
    "logical_child_id",
    "harness",
    "compiler",
    "registry_revision",
    "procedures",
    "catalog_suppression_set",
    "compiled_prompt_sha256",
    "invalidation_keys",
    "followup_policy"
  ],
  "properties": {
    "schema": {
      "const": "bbk.compiled-procedure-manifest.v1"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "logical_child_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness": {
      "enum": [
        "CODEX",
        "OMP",
        "CLAUDE",
        "PI",
        "OTHER"
      ]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "registry_revision": {
      "type": "string",
      "minLength": 1
    },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/procedure"
      }
    },
    "catalog_suppression_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compiled_prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "invalidation_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "followup_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_by_default",
        "recompile_triggers"
      ],
      "properties": {
        "preserve_by_default": {
          "const": true
        },
        "recompile_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identity_kind": {
      "enum": [
        "ROLE",
        "CONTROLLER"
      ]
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "effective_external_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "compiled_tail_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "utf8_bytes",
        "estimated_tokens"
      ],
      "properties": {
        "characters": {
          "type": "integer",
          "minimum": 1
        },
        "utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source_ref",
        "source_sha256",
        "effective_sha256",
        "selection_reason",
        "ordering",
        "catalog_visibility",
        "state",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "effective_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selection_reason": {
          "type": "string",
          "pattern": "^(PRIMARY|ROLE_REQUIRED|PROFILE|INVOCATION|POLICY|DEPENDENCY(?:_OF:[a-z0-9-]+)?)$"
        },
        "ordering": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_visibility": {
          "const": "SUPPRESSED"
        },
        "state": {
          "const": "COMPILED_COMPLETE"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
