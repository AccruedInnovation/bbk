{
  "$defs": {
    "artifactDescriptor": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/safeId"
        },
        "mediaType": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/safeId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifactId",
        "path",
        "role"
      ],
      "type": "object"
    },
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "predecessor": {
      "additionalProperties": false,
      "properties": {
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packageId": {
          "$ref": "#/$defs/safeId"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "packageId",
        "revision",
        "contentSha256"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "profileRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "safeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "sealedArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/safeId"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "canonicalization": {
          "enum": [
            "BBK-JSON-1",
            "UNCHANGED"
          ]
        },
        "mediaType": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/safeId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artifactId",
        "path",
        "role",
        "bytes",
        "sha256",
        "canonicalization"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    }
  },
  "$id": "https://bbk.local/schemas/bbk-artifact-package-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/sealedArtifact"
      },
      "minItems": 1,
      "type": "array"
    },
    "canonicalization": {
      "const": "BBK-JSON-1"
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "lifecycle": {
      "const": "SEALED"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "packageId": {
      "$ref": "#/$defs/safeId"
    },
    "predecessor": {
      "$ref": "#/$defs/predecessor"
    },
    "profile": {
      "$ref": "#/$defs/profileRef"
    },
    "revision": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "schema": {
      "const": "bbk.artifact-package.v1"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    }
  },
  "required": [
    "schema",
    "packageId",
    "revision",
    "profile",
    "subject",
    "artifacts",
    "contentSha256",
    "canonicalization",
    "lifecycle"
  ],
  "title": "BBK sealed artifact package descriptor v1",
  "type": "object"
}
