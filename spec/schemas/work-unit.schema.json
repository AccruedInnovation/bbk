    },
    "stateDecisionEffectRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "stateTransitionTraceRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "state_decision_effect_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "state_transition_trace_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "supportedOutcomeRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "taskProfile": {
      "minLength": 1,
      "type": "string"
    },
    "task_profile": {
      "minLength": 1,
      "type": "string"
    },
    "temporaryScaffolding": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "touchpoint": {
      "type": "string"
    },
    "verificationPlan": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "id",
    "purpose"
  ],
  "title": "BBK work unit v1 (alpha.3–alpha.7 compatible)",
  "type": "object"
}
