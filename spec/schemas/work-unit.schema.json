{
  "$id": "https://bbk.local/schemas/work-unit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "schema"
          ]
        },
        {
          "not": {
            "required": [
              "schema"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "task_profile",
            "assurance_tier"
          ]
        },
        {
          "required": [
            "taskProfile",
            "assuranceTier",
            "role",
            "scope",
            "expectedBehavior",
            "verificationPlan"
          ]
        }
      ]
    }
  ],
  "properties": {
    "affectedPaths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "assertions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "assuranceContractRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "assuranceTier": {
      "enum": [
        "routine",
        "material",
        "consequential",
        "critical"
      ]
    },
    "assurance_contract_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "assurance_tier": {
      "enum": [
        "routine",
        "material",
        "consequential",
        "critical"
      ]
    },
    "changeClasses": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "change_classes": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "executionSliceIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "expectedBehavior": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "handoffSchema": {
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
