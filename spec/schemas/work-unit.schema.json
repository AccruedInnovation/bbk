    "reviewManifestRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review_manifest_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "role": {
      "enum": [
        "worker",
        "validator",
        "reviewer",
        "prototyper",
        "architect",
        "wayfinder"
      ]
    },
    "scaffoldingDisposition": {
      "type": "string"
    },
    "schema": {
      "const": "bbk.work-unit.v1"
    },
    "scope": {
      "items": {
        "type": "string"
