    "paths": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "plannedArtifactRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profileHints": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile_hints": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "minLength": 1,
      "type": "string"
    },
    "requiredSkills": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_gates": {
      "items": {
        "type": "string"
      },
      "type": "array",
