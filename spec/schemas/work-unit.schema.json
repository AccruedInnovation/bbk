{
  "$id": "https://bbk.local/schemas/work-unit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "schema"
          ]
        },
        {
          "not": {
            "required": [
              "schema"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "task_profile",
            "assurance_tier"
          ]
        },
        {
          "required": [
            "taskProfile",
            "assuranceTier",
            "role",
            "scope",
            "expectedBehavior",
            "verificationPlan"
          ]
        }
      ]
    }
  ],
  "properties": {
    "affectedPaths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "assertions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "assuranceContractRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "assuranceTier": {
      "enum": [
        "routine",
        "material",
        "consequential",
        "critical"
      ]
    },
    "assurance_contract_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "assurance_tier": {
      "enum": [
        "routine",
        "material",
        "consequential",
        "critical"
      ]
    },
    "authorityGrant": {
      "additionalProperties": false,
      "properties": {
        "allowedEffects": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "expiresWhen": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "prohibitedEffects": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "safeguards": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "standing": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "standing",
        "scope",
        "allowedEffects",
        "prohibitedEffects",
        "safeguards",
        "expiresWhen"
      ],
      "type": "object"
    },
    "capabilityZones": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "guards": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "kind": {
            "enum": [
              "disposable-candidate-root",
              "protected-worktree",
              "sealed-evidence"
            ]
          },
          "operations": {
            "items": {
              "enum": [
                "read",
                "create",
                "replace",
                "rename",
                "delete"
              ]
            },
            "type": "array",
            "uniqueItems": true
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path",
          "operations",
          "guards"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "changeClasses": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "change_classes": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "executionBudget": {
      "additionalProperties": false,
      "properties": {
        "checkpointIntervalSeconds": {
          "minimum": 60,
          "type": "integer"
        },
        "durableHandoff": {
          "type": "boolean"
        },
        "infrastructureContinuations": {
          "minimum": 0,
          "type": "integer"
        },
        "largeResultTransport": {
          "enum": [
            "conversation-only",
            "file-bytes-sha256"
          ]
        },
        "mode": {
          "enum": [
            "bounded",
            "extended-resumable"
          ]
        },
        "resumeSameThread": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "checkpointIntervalSeconds",
        "infrastructureContinuations",
        "resumeSameThread",
        "durableHandoff",
        "largeResultTransport"
      ],
      "type": "object"
    },
    "executionSliceIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "expectedBehavior": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "handoffSchema": {
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "implementationStructureContractRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "interruptPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowedReasons": {
          "items": {
            "enum": [
              "USER_CANCELLED",
              "CHILD_REQUESTED_STOP",
              "UNAUTHORIZED_EFFECT",
              "OWNERSHIP_COLLISION",
              "CONFIRMED_HANG",
              "OBSOLETE_WORK"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "heartbeatSemantics": {
          "const": "informational"
        },
        "rejectedReasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "waitTimeoutSemantics": {
          "const": "polling-only"
        }
      },
      "required": [
        "allowedReasons",
        "rejectedReasons",
        "heartbeatSemantics",
        "waitTimeoutSemantics"
      ],
      "type": "object"
    },
    "keyContractRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "languageProfiles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "language_profiles": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "payloadLimits": {
      "additionalProperties": false,
      "properties": {
        "maxInlineBytes": {
          "minimum": 0,
          "type": "integer"
        },
        "maxToolResultBytes": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "onExceed": {
          "enum": [
            "fail-before-mutation",
            "file-bytes-sha256"
          ]
        },
        "silentTruncationAllowed": {
          "const": false
        }
      },
      "required": [
        "maxInlineBytes",
        "onExceed",
        "silentTruncationAllowed"
      ],
      "type": "object"
    },
    "plannedArtifactRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profileHints": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile_hints": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "minLength": 1,
      "type": "string"
    },
    "requiredSkills": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_gates": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "returnContract": {
      "additionalProperties": false,
      "properties": {
        "operationalDispositions": {
          "items": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "READY_FOR_VALIDATION",
              "BLOCKED_TECHNICAL",
              "BLOCKED_AUTHORITY",
              "BLOCKED_DECISION",
              "PAUSED_CAPACITY",
              "PAUSED_HOST_WINDOW",
              "CANCELLED",
              "INCONCLUSIVE"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requiredFields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema",
        "requiredFields",
        "operationalDispositions"
      ],
      "type": "object"
    },
    "reviewManifestRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review_manifest_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "role": {
      "enum": [
        "worker",
        "validator",
        "reviewer",
        "prototyper",
        "architect",
        "wayfinder"
      ]
    },
    "scaffoldingDisposition": {
      "type": "string"
    },
    "schema": {
      "const": "bbk.work-unit.v1"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "solutionOutcomeFitRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "stateDecisionEffectRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "stateTransitionTraceRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "state_decision_effect_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "state_transition_trace_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "supportedOutcomeRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "taskProfile": {
      "minLength": 1,
      "type": "string"
    },
    "task_profile": {
      "minLength": 1,
      "type": "string"
    },
    "temporaryScaffolding": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "toolEnvironment": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "minLength": 1,
                "type": "string"
              },
              "expectedVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fallbackCommand": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "versionCommand": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "command",
              "versionCommand"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "tools"
      ],
      "type": "object"
    },
    "touchpoint": {
      "type": "string"
    },
    "verificationPlan": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "id",
    "purpose"
  ],
  "title": "BBK work unit v1 (alpha.3–alpha.7 compatible)",
  "type": "object"
}
