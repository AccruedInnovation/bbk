{
  "$id": "bbk-qualified-task-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "binding_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "environment_allowlist": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
      "type": "string"
    },
    "schema": {
      "const": "bbk.qualified-task-request.v1"
    },
    "task": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
      "type": "string"
    },
    "toolchain_definition_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "binding_ref",
    "task",
    "candidate_digest",
    "toolchain_definition_digest",
    "idempotency_key"
  ],
  "title": "BBK qualified task request v1",
  "type": "object"
}
