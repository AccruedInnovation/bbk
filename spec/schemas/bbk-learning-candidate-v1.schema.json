    },
    "candidateType": {
      "minLength": 1,
      "type": "string"
    },
    "causalConfidence": {
      "minLength": 1,
      "type": "string"
    },
    "contraryEvidenceRefs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "exportClass": {
      "minLength": 1,
      "type": "string"
    },
    "privacyClass": {
      "minLength": 1,
      "type": "string"
    },
    "proposedAction": {
      "minLength": 1,
      "type": "string"
