{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-role-v4.schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "roleName": {
      "type": "string",
      "pattern": "^bbk_[a-z][a-z0-9_]*$"
    },
    "returnContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "envelope_schema",
        "return_schema",
        "result_schema",
        "semantic_state_name",
        "allowed_invocation_modes",
        "allowed_return_kinds",
        "allowed_operational_dispositions",
        "allowed_semantic_states",
        "supplemental_enums",
        "result_fields",
        "requirements",
        "readiness_rule",
        "authority_boundary"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^bbk\\.[a-z0-9][a-z0-9.-]*-return\\.v[0-9]+$"
        },
        "envelope_schema": {
          "const": "spec/schemas/bbk-role-return-v1.schema.json"
        },
        "return_schema": {
          "type": "string",
          "pattern": "^spec/schemas/role-returns/bbk-[a-z][a-z0-9-]*-return-v[0-9]+\\.schema\\.json$"
        },
        "result_schema": {
          "type": "string",
          "pattern": "^spec/schemas/role-results/bbk-[a-z][a-z0-9-]*-result-v[0-9]+\\.schema\\.json$"
        },
        "semantic_state_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "allowed_invocation_modes": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "allowed_return_kinds": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "allowed_operational_dispositions": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "allowed_semantic_states": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "supplemental_enums": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyStringList"
          }
        },
        "result_fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/resultField"
          }
        },
        "requirements": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "readiness_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authority_boundary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "resultField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nullable",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "STRING",
            "STRING_LIST",
            "BOOLEAN",
            "INTEGER",
            "NUMBER",
            "REFERENCE",
            "REFERENCE_LIST",
            "ARTIFACT_REFERENCE",
            "ARTIFACT_REFERENCE_LIST",
            "STRUCTURED",
            "STRUCTURED_LIST",
            "ENUM",
            "ENUM_LIST"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "enum_values": {
          "$ref": "#/$defs/nonEmptyStringList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "ENUM",
                  "ENUM_LIST"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "enum_values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "enum_values"
              ]
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "title",
    "family",
    "description",
    "purpose",
    "constitution",
    "scope",
    "responsibilities",
    "delegation",
    "escalations",
    "human_decision_triggers",
    "prohibitions",
    "skills",
    "primary_skill",
    "mandatory_skills",
    "prompt_modules",
    "mutates",
    "spawns",
    "web",
    "return_contract"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "$ref": "#/$defs/roleName"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "family": {
      "enum": [
        "planning",
        "specialist",
        "execution",
        "review"
      ]
    },
    "description": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "purpose": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "constitution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "scope": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "responsibilities": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "delegation": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/roleName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "escalations": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "human_decision_triggers": {
      "$ref": "#/$defs/stringList"
    },
    "prohibitions": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^bbk(?:-[a-z0-9]+)+$"
      },
      "uniqueItems": true
    },
    "primary_skill": {
      "type": "string",
      "pattern": "^bbk(?:-[a-z0-9]+)+$"
    },
    "mandatory_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^bbk(?:-[a-z0-9]+)+$"
      },
      "uniqueItems": true
    },
    "prompt_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^bbk-prompt-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "mutates": {
      "type": "boolean"
    },
    "spawns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roleName"
      },
      "uniqueItems": true
    },
    "web": {
      "type": "boolean"
    },
    "return_contract": {
      "$ref": "#/$defs/returnContract"
    }
  }
}
