{
  "$id": "https://bbk.local/schemas/bbk-artifact-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bbk_version": {
      "minLength": 1,
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "file_count": {
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "root_label": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "bbk.artifact-manifest.v1"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_bytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "bbk_version",
    "subject",
    "root_label",
    "content_sha256",
    "file_count",
    "total_bytes",
    "files"
  ],
  "title": "BBK deterministic artifact manifest",
  "type": "object"
}
