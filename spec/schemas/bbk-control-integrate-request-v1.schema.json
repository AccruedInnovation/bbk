{
  "$id": "bbk-control-integrate-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BBK orchestrator integration request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bbk.control-integrate-request.v1"
    },
    "host_version": {
      "const": "omp/16.4.8"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "binding_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "work_unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "payload_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional compatibility field. Current Alpha.17 OMP requests omit it and BBK derives the Beads revision internally; exact retries reuse the immutable idempotency-record revision."
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "finding_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "source_candidate_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "target_candidate_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "conflict_classification": {
      "enum": [
        "NONE",
        "CONTENT_NEUTRAL",
        "CONTENT_CHANGING",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "schema",
    "host_version",
    "session_id",
    "binding_ref",
    "invocation_id",
    "command_id",
    "work_unit_id",
    "attempt_id",
    "correlation_id",
    "payload_summary",
    "idempotency_key",
    "source_candidate_refs",
    "target_candidate_ref",
    "conflict_classification"
  ]
}
