{
  "$defs": {
    "nonEmpty": {
      "minLength": 1,
      "type": "string"
    },
    "packageRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/safeId"
        },
        "kind": {
          "$ref": "#/$defs/nonEmpty"
        },
        "path": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "required": [
        "artifactId",
        "path",
        "kind"
      ],
      "type": "object"
    },
    "safeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "$ref": "#/$defs/nonEmpty"
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "zone": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "disposable-candidate-root",
            "protected-worktree",
            "sealed-evidence"
          ]
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "required": [
        "kind",
        "path",
        "operations"
      ],
      "type": "object"
    }
  },
  "$id": "https://bbk.local/schemas/bbk-handoff-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Semantic handoff record separated from tool-owned package hashes and manifests.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/packageRef"
      },
      "type": "array"
    },
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "authority": {
      "type": [
        "object",
        "null"
      ]
    },
    "authority_boundary": {
      "$ref": "#/$defs/nonEmpty"
    },
    "bbk_version": {
      "$ref": "#/$defs/nonEmpty"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "capability_zones_used": {
      "items": {
        "$ref": "#/$defs/zone"
      },
      "type": "array"
    },
    "changed_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "continuation": {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "resume_same_thread": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "NOT_REQUIRED",
            "READY",
            "WAITING",
            "BLOCKED"
          ]
        }
      },
      "required": [
        "state",
        "checkpoint",
        "resume_same_thread",
        "completed_step",
        "next_step"
      ],
      "type": "object"
    },
    "created_at": {
      "$ref": "#/$defs/nonEmpty"
    },
    "discoveries": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "disposition": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED_TECHNICAL",
        "BLOCKED_AUTHORITY",
        "BLOCKED_DECISION",
        "PAUSED_CAPACITY",
        "PAUSED_HOST_WINDOW",
        "CANCELLED",
        "INCONCLUSIVE"
      ]
    },
    "effects_and_cleanup": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "residuals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "NOT_REQUIRED",
            "COMPLETE",
            "PARTIAL",
            "BLOCKED",
            "QUARANTINED"
          ]
        }
      },
      "required": [
        "state",
        "actions",
        "residuals"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/packageRef"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/safeId"
    },
    "interrupt": {
      "type": [
        "object",
        "null"
      ]
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/nonEmpty"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role",
        "invocation_id",
        "thread_id"
      ],
      "type": "object"
    },
    "prohibited_claims": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "residual_uncertainty": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "const": "bbk.handoff.v2"
    },
    "smallest_next_action": {
      "$ref": "#/$defs/nonEmpty"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "summary": {
      "$ref": "#/$defs/nonEmpty"
    },
    "work_performed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "work_unit_id": {
      "$ref": "#/$defs/safeId"
    }
  },
  "required": [
    "schema",
    "bbk_version",
    "id",
    "project_id",
    "work_unit_id",
    "attempt",
    "producer",
    "subject",
    "authority",
    "capability_zones_used",
    "interrupt",
    "disposition",
    "summary",
    "work_performed",
    "changed_paths",
    "commands",
    "checks",
    "findings",
    "discoveries",
    "residual_uncertainty",
    "blockers",
    "artifacts",
    "evidence",
    "effects_and_cleanup",
    "continuation",
    "prohibited_claims",
    "smallest_next_action",
    "created_at",
    "authority_boundary"
  ],
  "title": "BBK sealed handoff semantic record v2",
  "type": "object"
}
