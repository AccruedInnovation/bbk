{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-role-return-registry-v2.schema.json",
  "title": "BBK role-return registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_version",
    "source_role_catalog",
    "envelope_schema",
    "v1_registry",
    "generator",
    "role_count",
    "default_detail_level",
    "allowed_detail_levels",
    "operational_dispositions",
    "entries"
  ],
  "properties": {
    "schema": {"const": "bbk.role-return-registry.v2"},
    "package_version": {"type": "string", "minLength": 1},
    "source_role_catalog": {"const": "spec/roles/catalog.json"},
    "envelope_schema": {"const": "spec/schemas/bbk-role-return-v2.schema.json"},
    "v1_registry": {"const": "spec/contracts/role-return-registry.json"},
    "generator": {"const": "tools/return_contracts.py"},
    "role_count": {"const": 19},
    "default_detail_level": {"const": "COMPACT"},
    "allowed_detail_levels": {"const": ["COMPACT", "FULL"]},
    "operational_dispositions": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "entries": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "contract_id",
        "default_detail_level",
        "allowed_detail_levels",
        "semantic_state_name",
        "return_schema",
        "compact_result_schema",
        "full_result_schema",
        "v1_compatibility",
        "compact_result_fields",
        "full_detail_triggers",
        "source"
      ],
      "properties": {
        "role": {"type": "string", "pattern": "^bbk_[a-z][a-z0-9_]*$"},
        "contract_id": {"type": "string", "pattern": "^bbk\\.[a-z0-9][a-z0-9.-]*-return\\.v2$"},
        "default_detail_level": {"const": "COMPACT"},
        "allowed_detail_levels": {"const": ["COMPACT", "FULL"]},
        "semantic_state_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "return_schema": {"$ref": "#/$defs/pathDigest"},
        "compact_result_schema": {"$ref": "#/$defs/pathDigest"},
        "full_result_schema": {"$ref": "#/$defs/pathDigest"},
        "v1_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_id", "return_schema"],
          "properties": {
            "contract_id": {"type": "string", "pattern": "^bbk\\.[a-z0-9][a-z0-9.-]*-return\\.v1$"},
            "return_schema": {"type": "string", "pattern": "^spec/schemas/role-returns/.+-return-v1\\.schema\\.json$"}
          }
        },
        "compact_result_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "full_detail_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source": {"$ref": "#/$defs/pathDigest"}
      }
    }
  }
}
