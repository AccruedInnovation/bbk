{
  "$defs": {
    "fileReference": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "fileReferences": {
      "items": {
        "$ref": "#/$defs/fileReference"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "$id": "https://bbk.local/schemas/bbk-handoff-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/fileReferences"
    },
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "standing": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "bbk_version": {
      "minLength": 1,
      "type": "string"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "capability_zones_used": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "disposable-candidate-root",
              "protected-worktree",
              "sealed-evidence"
            ]
          },
          "operations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "changed_paths": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "checks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "continuation": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "resume_same_thread": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "NOT_REQUIRED",
            "READY",
            "WAITING",
            "BLOCKED"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "discoveries": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "disposition": {
      "enum": [
        "COMPLETE",
        "READY_FOR_VALIDATION",
        "PARTIAL",
        "BLOCKED",
        "PAUSED",
        "CANCELLED",
        "INCONCLUSIVE",
        "BLOCKED_TECHNICAL",
        "BLOCKED_AUTHORITY",
        "BLOCKED_DECISION",
        "PAUSED_CAPACITY",
        "PAUSED_HOST_WINDOW"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/fileReferences"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "interrupt": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "partial_work_location": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "enum": [
            "USER_CANCELLED",
            "CHILD_REQUESTED_STOP",
            "UNAUTHORIZED_EFFECT",
            "OWNERSHIP_COLLISION",
            "CONFIRMED_HANG",
            "OBSOLETE_WORK"
          ]
        }
      },
      "required": [
        "reason",
        "evidence"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "residual_uncertainty": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "const": "bbk.handoff.v1"
    },
    "smallest_next_action": {
      "minLength": 1,
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "work_performed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "work_unit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "bbk_version",
    "id",
    "work_unit_id",
    "attempt",
    "producer",
    "subject",
    "disposition",
    "summary",
    "artifacts",
    "evidence",
    "smallest_next_action",
    "created_at"
  ],
  "title": "BBK durable handoff",
  "type": "object"
}
