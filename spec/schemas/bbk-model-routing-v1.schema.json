{
  "$id": "https://bbk.local/schemas/bbk-model-routing-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BBK Model Routing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_version",
    "description",
    "profiles",
    "role_profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "bbk.model-routing.v1"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "role_profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^bbk_[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "omp",
        "codex",
        "claude"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "omp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "thinkingLevel"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinkingLevel": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "model_reasoning_effort"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_reasoning_effort": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "effort"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
