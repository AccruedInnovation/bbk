{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-verification-economy-metrics-v1.schema.json",
  "title": "BBK verification-economy metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source_digest", "status", "totals", "sessions", "latency", "verification", "coordination", "attempts", "product_quality", "prompt", "budgets", "metrics_digest"],
  "properties": {
    "schema": {"const": "bbk.verification-economy-metrics.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["PASS", "FAIL"]},
    "totals": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "sessions": {"type": "object", "additionalProperties": true},
    "latency": {"type": "object", "additionalProperties": true},
    "verification": {"type": "object", "additionalProperties": true},
    "coordination": {"type": "object", "additionalProperties": true},
    "attempts": {"type": "object", "additionalProperties": true},
    "product_quality": {"type": "object", "additionalProperties": true},
    "prompt": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "violation_count", "violations"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "violation_count": {"type": "integer", "minimum": 0},
        "violations": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      }
    },
    "metrics_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
