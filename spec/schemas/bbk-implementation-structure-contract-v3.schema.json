      "properties": {
        "delegated": {
          "items": {
            "$ref": "#/$defs/delegatedDecision"
          },
          "type": "array"
        },
        "fixed": {
          "items": {
            "$ref": "#/$defs/fixedDecision"
          },
          "type": "array"
        },
        "prohibited": {
          "items": {
            "minLength": 1,
