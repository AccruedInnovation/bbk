      "const": "bbk.implementation-structure-contract.v3"
    },
    "stateDecisionEffectDesign": {
      "$ref": "bbk-state-decision-effect-design-v1.schema.json"
    },
    "status": {
      "enum": [
        "draft",
        "in-review",
        "accepted",
        "superseded"
      ]
    },
    "structure": {
      "additionalProperties": false,
      "properties": {
        "artifactTopology": {
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "type": "array"
        },
        "behaviorPaths": {
          "items": {
            "$ref": "#/$defs/behaviorPath"
          },
          "type": "array"
        },
        "effectBoundaries": {
          "items": {
