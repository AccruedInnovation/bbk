          },
          "type": "array"
        },
        "stateOwnership": {
          "items": {
            "$ref": "#/$defs/stateOwner"
          },
          "type": "array"
        },
        "testSeams": {
          "items": {
            "$ref": "#/$defs/namedStatement"
          },
          "type": "array"
        }
      },
      "required": [
        "artifactTopology",
        "keyContracts",
        "behaviorPaths",
        "stateOwnership",
        "effectBoundaries",
        "testSeams",
        "observabilityPoints",
        "migrationTouchpoints"
      ],
