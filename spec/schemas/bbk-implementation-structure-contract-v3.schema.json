        },
        "acceptedBy": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "assuranceTier": {
          "enum": [
            "routine",
            "material",
            "consequential",
            "critical"
          ]
        },
        "requiredReviewers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reviewRefs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "assuranceTier",
        "requiredReviewers",
        "acceptanceCriteria"
      ],
      "type": "object"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
