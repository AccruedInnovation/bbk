    "sectionApplicability": {
      "additionalProperties": false,
      "properties": {
        "stateDecisionEffect": {
          "$ref": "#/$defs/sectionApplicability"
        },
        "migration": {
          "$ref": "#/$defs/sectionApplicability"
        },
        "failureRecovery": {
