  "required": [
    "schema",
    "contractId",
    "revision",
    "title",
    "status",
    "subject",
    "applicability",
    "structure",
    "decisions",
    "review",
    "contractDepth",
    "sectionApplicability",
    "preExecutionConfirmations",
    "specialistDispositions"
  ],
  "title": "BBK Implementation Structure Contract v3",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "sectionApplicability": {
            "properties": {
              "stateDecisionEffect": {
                "properties": {
                  "status": {
                    "const": "REQUIRED"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "stateDecisionEffect"
            ]
          }
        },
        "required": [
          "sectionApplicability"
        ]
      },
      "then": {
        "required": [
          "stateDecisionEffectDesign"
        ]
      }
    }
  ]
}
