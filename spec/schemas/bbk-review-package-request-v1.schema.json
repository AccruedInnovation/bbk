{
  "$defs": {
    "focus": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonEmpty"
        },
        {
          "minProperties": 1,
          "type": "object"
        }
      ]
    },
    "nonEmpty": {
      "minLength": 1,
      "type": "string"
    },
    "nonEmptyArray": {
      "minItems": 1,
      "type": "array"
    }
  },
  "$id": "https://bbk.local/schemas/bbk-review-package-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REVIEW"
          }
        }
      },
      "then": {
        "required": [
          "exactFocus",
          "applicableFloors",
          "priorFindings"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "FOCUSED_RECHECK"
          }
        }
      },
      "then": {
        "required": [
          "finding",
          "affectedScope",
          "relevantEvidence",
          "reopeningTriggers",
          "semanticChange"
        ]
      }
    }
  ],
  "description": "Exact semantic inputs for generating a candidate-bound review or focused recheck package. The compiler does not infer missing focus, floors, findings, evidence, or authority.",
  "properties": {
    "affectedScope": {
      "$ref": "#/$defs/nonEmptyArray"
    },
    "applicableFloors": {
      "type": "array"
    },
    "assuranceMode": {
      "$ref": "bbk-assurance-mode-v1.schema.json"
    },
    "broaderReviewContext": {
      "minProperties": 1,
      "type": "object"
    },
    "exactFocus": {
      "$ref": "#/$defs/focus"
    },
    "finding": {
      "minProperties": 1,
      "type": "object"
    },
    "mode": {
      "enum": [
        "REVIEW",
        "FOCUSED_RECHECK"
      ]
    },
    "priorFindings": {
      "type": "array"
    },
    "relevantEvidence": {
      "$ref": "#/$defs/nonEmptyArray"
    },
    "reopeningTriggers": {
      "$ref": "#/$defs/nonEmptyArray"
    },
    "schema": {
      "const": "bbk.review-package-request.v1"
    },
    "semanticChange": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "mode",
    "assuranceMode"
  ],
  "title": "BBK generated review package request v1",
  "type": "object"
}
