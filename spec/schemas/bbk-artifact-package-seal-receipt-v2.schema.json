{
  "$defs": {
    "nonEmpty": {
      "minLength": 1,
      "type": "string"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "safeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "$ref": "#/$defs/nonEmpty"
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "bbk"
        },
        "version": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://bbk.local/schemas/bbk-artifact-package-seal-receipt-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorityBoundary": {
      "$ref": "#/$defs/nonEmpty"
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidenceClass": {
      "const": "INFORMATIONAL"
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "operationId": {
      "format": "uuid",
      "type": "string"
    },
    "packageId": {
      "$ref": "#/$defs/safeId"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "publicationState": {
      "const": "NON_PUBLISHED"
    },
    "revision": {
      "$ref": "#/$defs/nonEmpty"
    },
    "schema": {
      "const": "bbk.artifact-package-seal-receipt.v2"
    },
    "sealedAtUtc": {
      "format": "date-time",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    }
  },
  "required": [
    "schema",
    "packageId",
    "revision",
    "profile",
    "subject",
    "contentSha256",
    "manifestSha256",
    "sealedAtUtc",
    "tool",
    "authorityBoundary",
    "operationId",
    "publicationState",
    "evidenceClass"
  ],
  "title": "BBK artifact package informational seal receipt v2",
  "type": "object"
}


