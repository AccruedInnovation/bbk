{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/safeId"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "canonicalization": {
          "enum": [
            "BBK-JSON-1",
            "UNCHANGED"
          ]
        },
        "evidenceClass": {
          "enum": [
            "PRODUCT",
            "PRODUCER",
            "VALIDATION",
            "AUTHORITY",
            "TRANSPORT",
            "INFORMATIONAL"
          ]
        },
        "mediaType": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/safeId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/nonEmpty"
        },
        "schema": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artifactId",
        "path",
        "role",
        "bytes",
        "sha256",
        "canonicalization"
      ],
      "type": "object"
    },
    "closure": {
      "additionalProperties": false,
      "properties": {
        "artifactCount": {
          "minimum": 1,
          "type": "integer"
        },
        "referenceCount": {
          "minimum": 0,
          "type": "integer"
        },
        "unresolved": {
          "maxItems": 0,
          "type": "array"
        }
      },
      "required": [
        "artifactCount",
        "referenceCount",
        "unresolved"
      ],
      "type": "object"
    },
    "edge": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/safeId"
        },
        "to": {
          "$ref": "#/$defs/safeId"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "nonEmpty": {
      "minLength": 1,
      "type": "string"
    },
    "predecessor": {
      "additionalProperties": false,
      "properties": {
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packageId": {
          "$ref": "#/$defs/safeId"
        },
        "revision": {
          "$ref": "#/$defs/nonEmpty"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "packageId",
        "revision",
        "contentSha256",
        "manifestSha256"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "safeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "$ref": "#/$defs/nonEmpty"
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    }
  },
  "$id": "https://bbk.local/schemas/bbk-artifact-package-manifest-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1,
      "type": "array"
    },
    "canonicalization": {
      "const": "BBK-JSON-1"
    },
    "closure": {
      "$ref": "#/$defs/closure"
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "metadata": {
      "type": "object"
    },
    "packageId": {
      "$ref": "#/$defs/safeId"
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/predecessor"
        }
      ]
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "referenceGraph": {
      "items": {
        "$ref": "#/$defs/edge"
      },
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/nonEmpty"
    },
    "schema": {
      "const": "bbk.artifact-package-manifest.v2"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "successorReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "packageId",
    "revision",
    "profile",
    "subject",
    "canonicalization",
    "artifacts",
    "referenceGraph",
    "closure",
    "contentSha256"
  ],
  "title": "BBK detached artifact package manifest v2",
  "type": "object"
}


