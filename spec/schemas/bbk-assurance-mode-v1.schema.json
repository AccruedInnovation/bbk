{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-assurance-mode-v1.schema.json",
  "title": "BBK proportional assurance mode v1",
  "description": "A bounded INLINE, FOCUSED, or FULL assurance selection. This record guides work and context generation; it does not authorize effects or accept a candidate.",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "subjectReference": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "$ref": "#/$defs/nonEmptyString"
            }
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "subject_ref",
    "risk_basis",
    "rationale",
    "review_focus",
    "recheck_scope",
    "independent_review_required"
  ],
  "properties": {
    "schema": {
      "const": "bbk.assurance-mode.v1"
    },
    "mode": {
      "enum": [
        "INLINE",
        "FOCUSED",
        "FULL"
      ]
    },
    "subject_ref": {
      "$ref": "#/$defs/subjectReference"
    },
    "risk_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "rationale": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "review_focus": {
      "$ref": "#/$defs/stringList"
    },
    "recheck_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "independent_review_required": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "INLINE"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "independent_review_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "FOCUSED",
              "FULL"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "independent_review_required": {
            "const": true
          },
          "review_focus": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "uniqueItems": true
          }
        }
      }
    }
  ]
}
