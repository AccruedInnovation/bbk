{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-prompt-compilation-plan-v1.schema.json",
  "title": "BBK Prompt Compilation Plan v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "identity_kind",
    "identity_name",
    "harness",
    "logical_child_id",
    "primary_procedure",
    "selected_procedure_closure",
    "base_prompt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bbk.prompt-compilation-plan.v1"
    },
    "identity_kind": {
      "enum": [
        "ROLE",
        "CONTROLLER"
      ]
    },
    "identity_name": {
      "type": "string",
      "minLength": 1
    },
    "harness": {
      "enum": [
        "codex",
        "omp",
        "claude",
        "pi",
        "generic"
      ]
    },
    "logical_child_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_procedure": {
      "type": "string",
      "minLength": 1
    },
    "selected_procedure_closure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
