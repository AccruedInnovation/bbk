{
  "$id": "bbk-coordination-command-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BBK typed orchestrator coordination command v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bbk.coordination-command.v1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "operation": {
      "enum": [
        "ASSIGN",
        "UPDATE",
        "INTEGRATE_REQUEST"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "bbk_root_orchestrator",
            "bbk_territory_orchestrator",
            "bbk_worker_orchestrator",
            "bbk_validator_orchestrator"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "binding_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capability_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "role",
        "session_id",
        "invocation_id",
        "binding_ref",
        "authority_ref",
        "capability_ref"
      ]
    },
    "work_unit": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "attempt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "transition": {
      "enum": [
        "CREATE",
        "START",
        "BLOCK",
        "UNBLOCK",
        "COMPLETE",
        "FAIL",
        "ANNOTATE"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "payload_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "maxLength": 512
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "finding_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker_binding_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "attempt_registration_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "assignee_role": {
          "type": "string",
          "pattern": "^bbk_[A-Za-z0-9_]+$"
        },
        "task_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workspace_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "jj_change_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "assignment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packet_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "task_input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "worker_binding_ref",
        "attempt_registration_ref",
        "assignee_role",
        "task_name",
        "candidate_ref",
        "workspace_ref",
        "jj_change_id",
        "assignment_digest",
        "packet_digest",
        "task_input_digest"
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_candidate_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "target_candidate_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "conflict_classification": {
          "enum": [
            "NONE",
            "CONTENT_NEUTRAL",
            "CONTENT_CHANGING",
            "UNKNOWN"
          ]
        },
        "requested_route": {
          "enum": [
            "CONTENT_NEUTRAL_INTEGRATION_ADAPTER",
            "BOUND_INTEGRATION_WORKER"
          ]
        },
        "integration_worker_required": {
          "type": "boolean"
        },
        "orchestrator_conflict_resolution_authority": {
          "const": "DENIED"
        },
        "effect_performed": {
          "const": "REQUEST_RECORDED_ONLY"
        }
      },
      "required": [
        "source_candidate_refs",
        "target_candidate_ref",
        "conflict_classification",
        "requested_route",
        "integration_worker_required",
        "orchestrator_conflict_resolution_authority",
        "effect_performed"
      ]
    }
  },
  "required": [
    "schema",
    "command_id",
    "operation",
    "actor",
    "work_unit",
    "attempt",
    "transition",
    "correlation_id",
    "payload_summary",
    "expected_revision",
    "idempotency_key",
    "evidence_refs",
    "finding_refs"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "ASSIGN"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "assignment"
        ],
        "properties": {
          "transition": {
            "enum": [
              "CREATE",
              "ANNOTATE"
            ]
          },
          "integration": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "INTEGRATE_REQUEST"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "integration"
        ],
        "properties": {
          "transition": {
            "enum": [
              "CREATE",
              "ANNOTATE"
            ]
          },
          "assignment": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "UPDATE"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "transition": {
            "enum": [
              "START",
              "BLOCK",
              "UNBLOCK",
              "COMPLETE",
              "FAIL",
              "ANNOTATE"
            ]
          },
          "assignment": false,
          "integration": false
        }
      }
    }
  ]
}
