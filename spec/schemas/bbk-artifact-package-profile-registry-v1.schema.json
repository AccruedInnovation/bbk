{
  "$defs": {
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "predecessor": {
      "additionalProperties": false,
      "properties": {
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packageId": {
          "$ref": "#/$defs/safeId"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "packageId",
        "revision",
        "contentSha256"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "profileRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "safeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    }
  },
  "$id": "https://bbk.local/schemas/bbk-artifact-package-profile-registry-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generatedFieldOwnership": {
      "additionalProperties": false,
      "properties": {
        "descriptorFields": {
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "type": "array",
          "uniqueItems": true
        },
        "generatedFiles": {
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "type": "array",
          "uniqueItems": true
        },
        "owner": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "required": [
        "descriptorFields",
        "generatedFiles",
        "owner"
      ],
      "type": "object"
    },
    "packageVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifactReferenceCycles": {
            "enum": [
              "FORBIDDEN",
              "ALLOWED"
            ]
          },
          "artifactRoles": {
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": "array",
            "uniqueItems": true
          },
          "description": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "descriptorSchema": {
            "$ref": "#/$defs/relativePath"
          },
          "id": {
            "$ref": "#/$defs/safeId"
          },
          "permittedSchemas": {
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": "array",
            "uniqueItems": true
          },
          "requiredSchemas": {
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": "array",
            "uniqueItems": true
          },
          "semanticValidators": {
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": "array",
            "uniqueItems": true
          },
          "successorClearPointers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "version": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "required": [
          "id",
          "version",
          "description",
          "descriptorSchema",
          "permittedSchemas",
          "requiredSchemas",
          "artifactRoles",
          "artifactReferenceCycles",
          "semanticValidators",
          "successorClearPointers"
        ],
        "type": "object"
      },
      "minItems": 5,
      "type": "array"
    },
    "registryVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "schema": {
      "const": "bbk.artifact-package-profile-registry.v1"
    }
  },
  "required": [
    "schema",
    "registryVersion",
    "packageVersion",
    "generatedFieldOwnership",
    "profiles"
  ],
  "title": "BBK artifact package profile registry v1",
  "type": "object"
}
