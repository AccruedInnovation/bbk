{
  "$defs": {
    "artifactDescriptor": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/safeId"
        },
        "mediaType": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/safeId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifactId",
        "path",
        "role"
      ],
      "type": "object"
    },
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "predecessor": {
      "additionalProperties": false,
      "properties": {
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packageId": {
          "$ref": "#/$defs/safeId"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "packageId",
        "revision",
        "contentSha256"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "profileRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "safeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    }
  },
  "$id": "https://bbk.local/schemas/bbk-artifact-package-draft-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifactDescriptor"
      },
      "minItems": 1,
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "packageId": {
      "$ref": "#/$defs/safeId"
    },
    "predecessor": {
      "$ref": "#/$defs/predecessor"
    },
    "profile": {
      "$ref": "#/$defs/profileRef"
    },
    "revision": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "schema": {
      "const": "bbk.artifact-package-draft.v1"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "successorReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "packageId",
    "revision",
    "profile",
    "subject",
    "artifacts"
  ],
  "title": "BBK artifact package draft v1",
  "type": "object"
}
