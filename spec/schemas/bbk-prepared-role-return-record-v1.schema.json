{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-prepared-role-return-record-v1.schema.json",
  "title": "BBK immutable prepared role-return record v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bbk.prepared-role-return-record.v1"
    },
    "return_ref": {
      "type": "string",
      "pattern": "^return:[0-9a-f]{64}$"
    },
    "binding_ref": {
      "type": "string",
      "pattern": "^binding:[0-9a-f]{64}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "pattern": "^bbk_[a-z][a-z0-9_]*$"
    },
    "return_contract": {
      "type": "string",
      "minLength": 1
    },
    "document_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_path": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "object",
      "minProperties": 1
    },
    "record_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding_identity_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "return_ref",
    "binding_ref",
    "session_id",
    "invocation_id",
    "role",
    "return_contract",
    "document_digest",
    "schema_path",
    "idempotency_key",
    "document",
    "record_digest",
    "binding_identity_digest"
  ]
}
